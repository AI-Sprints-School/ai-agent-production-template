# Скопируйте в .env и заполните по урокам. .env в git не попадает.

# Урок 1 — шлюз WorkAI
LLM_BASE_URL=https://api.workai.su/v1
LLM_MODEL=
LLM_API_KEY=

# Урок 3 — Neon: строка подключения Postgres
DATABASE_URL=

# Урок 3 — таймаут вызова модели в секундах; пусто — 60
LLM_TIMEOUT_S=

# Урок 4 — модель эмбеддингов для поиска по документам
EMBEDDING_MODEL=openai/text-embedding-3-small

# Урок 11 — модель LLM-судьи, отдельно от LLM_MODEL сервиса
JUDGE_MODEL=

# Урок 12 — учебная CRM: входящий вебхук целиком
CRM_WEBHOOK_URL=

# Урок 13 — отказы CRM: сколько секунд ждать ответа и сколько раз повторить временный отказ
CRM_TIMEOUT_S=10
CRM_RETRIES=2

# Урок 16 — Langfuse, если выбрали его; иначе трейсы в Neon
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Урок 20 — подтверждение человеком: тайм-аут в минутах и токен того, кто подтверждает
APPROVAL_TTL_MIN=60
APPROVER_TOKEN=

# Урок 22 — лимиты действий в сутки: LIMIT_<ИНСТРУМЕНТ>_PER_DAY и сумма сделок
LIMIT_CREATE_DEAL_PER_DAY=
LIMIT_DEAL_SUM_PER_DAY=

# Урок 25 — приёмник писем по публичному адресу: секрет и режим разбора (sync или async)
WEBHOOK_SECRET=
WEBHOOK_MODE=

# Урок 26 — CI: off — сервис работает без CRM
CRM_MODE=

# Урок 27 — эксплуатация: cron Vercel, тревога в Telegram, запасная версия промпта
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PROMPT_VERSION=

# Урок 28 — цены моделей на случай, когда шлюз не вернул usage.cost: модель=вход/выход за 1 млн токенов
COST_PRICES=

# Урок 29 — дешёвая модель на шаге и дневной лимит стоимости в рублях
LLM_MODEL_CHEAP=
LIMIT_COST_RUB_PER_DAY=
